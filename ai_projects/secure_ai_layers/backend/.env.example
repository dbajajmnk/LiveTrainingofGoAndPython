# Copy from your existing ai_explainer backend .env or paste your key here.
# Never commit the real .env file.
OPENAI_API_KEY=sk-your-key-here

# Model used for Intermediate / Advanced demos (cheap default).
OPENAI_MODEL=gpt-4.1-mini

# Optional: clients must send header X-API-Key: <this value> on Advanced routes.
# Empty = no API key check (still secure server-side key handling).
DEMO_API_KEY=
