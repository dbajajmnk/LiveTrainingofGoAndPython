# Cost Control Lab — root ignores (backend + frontend)

# Python / FastAPI
backend/.venv/
backend/.env
backend/.env.*
!backend/.env.example
backend/**/__pycache__/
backend/**/*.py[cod]
backend/**/.mypy_cache/
backend/**/.pytest_cache/
backend/**/.ruff_cache/

# Node / Vite
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Logs & OS
*.log
.DS_Store
Thumbs.db
.idea/
