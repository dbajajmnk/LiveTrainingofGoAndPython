OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Teaching knobs — smaller = cheaper demos
PROMPT_MAX_CHARS=600
MAX_OUTPUT_TOKENS=220

# In-memory cache size (LRU). Larger = more RAM, fewer repeat API calls.
CACHE_MAX_ENTRIES=64

# Rough $ per 1M tokens for *display only* — adjust to your model’s pricing page.
USD_PER_M_INPUT_TOKENS=0.15
USD_PER_M_OUTPUT_TOKENS=0.60
